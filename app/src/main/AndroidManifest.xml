<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Wi-Fi pill: Android only reveals the network name to apps holding location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Recently watched: Android TV's Watch Next list (Netflix, Prime Video…). -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- Talkies settings → Wallpaper → From this TV: pictures on the TV or a USB drive (asked only when you open it) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <!-- Trending picks: TMDB lists and backdrops. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Hold OK on an app → Uninstall: opens Android's own "Uninstall this app?" dialog. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Talkies settings → Updates: hands a newer release to Android's installer, which asks first. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Only if you grant it over adb (see ServiceRepair): puts the accessibility service back after a force stop,
         and lets Control Center → Network debugging turn debugging off. Talkies never asks for it. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        xmlns:tools="http://schemas.android.com/tools" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Control Center → Bluetooth: list paired speakers and connect or disconnect them. Android 12+ asks once
         ("Nearby devices"); before that it comes with the install. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- Android 11+ package visibility: without this the app grid comes up empty. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.tv.TvInputService" />
        </intent>
        <!-- The TV's built-in launchers, so the accessibility service can keep Home on Talkies. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Apps with only a phone-style entry, for Recent apps. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The TV's settings apps, maker's own included, for Control Center shortcuts. -->
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <intent><action android:name="android.settings.WIFI_SETTINGS" /></intent>
        <intent><action android:name="android.settings.BLUETOOTH_SETTINGS" /></intent>
        <intent><action android:name="android.settings.SOUND_SETTINGS" /></intent>
        <intent><action android:name="android.settings.DISPLAY_SETTINGS" /></intent>
        <intent><action android:name="android.settings.INTERNAL_STORAGE_SETTINGS" /></intent>
        <!-- Fire TV's own way to switch inputs (AppEntry.inputIntent). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tvinput" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.Glass"
        android:supportsRtl="false">

        <!-- Android's installer's answer to an update (SelfUpdate). -->
        <receiver android:name=".SelfUpdate$Receiver" android:exported="false" />

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Also listed as an app, so another launcher (Projectivy) can open it to switch back. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Control Center: Turn off now / sleep timer (the "lock" action); typing a match into JioHotstar's search. -->
        <service
            android:name=".SleepService"
            android:exported="true"
            android:label="@string/sleep_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/sleep_service" />
        </service>

        <receiver android:name=".Sleep$Alarm" android:exported="false" />

        <!-- After a restart or an update: put the accessibility service back if a force stop switched it off. -->
        <receiver android:name=".ServiceRepair$Starter" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Recently watched: holds notification access so Android shares which media sessions play and their
             titles (JioHotstar and YouTube only). It reads no notifications. -->
        <!-- Talkies as the TV's screensaver: a dim clock that moves (Screensaver). -->
        <service
            android:name=".Screensaver"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <service
            android:name=".WatchService"
            android:exported="true"
            android:label="@string/watch_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
