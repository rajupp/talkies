<?xml version="1.0" encoding="utf-8"?>
<!-- Talkies. 960 × 540 dp. The page holds everything that scrolls: header, picks, dock, then All apps below the
     fold. Colours are applied in code for the day or night theme. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background: theme gradient, the current pick's image (or your wallpaper) and the scrim, as one layer. -->
    <com.techpp.glass.Backdrop android:id="@+id/backdrop" android:layout_width="match_parent"
        android:layout_height="match_parent" android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Under the clock: the picks' tabs (the title is no longer shown; kept for the theme code) -->
        <LinearLayout
            android:id="@+id/for_you_head"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="98dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:includeFontPadding="false"
                android:letterSpacing="-0.015"
                android:text="For You"
                android:textSize="38sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:orientation="horizontal">
                <TextView android:id="@+id/tab_recent" style="@style/TabText" android:text="Continue" />
                <TextView android:id="@+id/tab_trending" style="@style/TabText" android:layout_marginStart="2dp" android:text="Trending" />
                <TextView android:id="@+id/tab_india" style="@style/TabText" android:layout_marginStart="2dp" android:text="New in India" />
            </LinearLayout>

            <!-- Only while there are no picks to show: why (no TMDB key yet, or offline) -->
            <TextView
                android:id="@+id/picks_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:fontFamily="@font/outfit"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Header, right: icon buttons, then time · date · weather -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="40dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="end"
            android:orientation="vertical">

            <!-- Not clipped: a focused icon grows past the row's edges -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">
                <!-- RAM and storage free, unless hidden in Talkies settings -->
                <com.techpp.glass.Meters android:id="@+id/meters" android:layout_width="112dp"
                    android:layout_height="44dp" android:layout_gravity="center_vertical"
                    android:layout_marginEnd="22dp" android:importantForAccessibility="no" />
                <ImageView android:id="@+id/icon_cc" style="@style/IconButton" android:src="@drawable/ic_cc" android:contentDescription="Control Center" />
                <ImageView android:id="@+id/icon_inputs" style="@style/IconButton" android:src="@drawable/ic_input" android:contentDescription="Inputs" />
                <ImageView android:id="@+id/icon_wifi" style="@style/IconButton" android:src="@drawable/ic_wifi" android:contentDescription="Wi-Fi" />
                <ImageView android:id="@+id/icon_settings" style="@style/IconButton" android:src="@drawable/ic_settings" android:contentDescription="Settings" />
                <!-- Shown only while the Play Store has updates waiting -->
                <ImageView android:id="@+id/icon_bell" style="@style/IconButton" android:src="@drawable/ic_bell" android:contentDescription="App updates" android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:fontFamily="@font/outfit"
                android:singleLine="true"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Cricket: the most relevant live (or today's) match, under the time and weather -->
        <TextView
            android:id="@+id/score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginTop="72dp"
            android:layout_marginEnd="40dp"
            android:fontFamily="@font/outfit"
            android:singleLine="true"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/credit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginTop="106dp"
            android:layout_marginEnd="40dp"
            android:fontFamily="@font/outfit"
            android:text="Picks from TMDB"
            android:textSize="11sp" />

        <!-- Weather, then time | date, top left. -->
        <LinearLayout
            android:id="@+id/big_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="26dp"
            android:orientation="vertical"
            >
            <TextView
                android:id="@+id/big_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:letterSpacing="0.14"
                android:singleLine="true"
                android:textAllCaps="true"
                android:textSize="12sp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/big_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-2dp"
                    android:fontFamily="@font/outfit"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="42sp" />
                <TextView
                    android:id="@+id/big_ampm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="@font/outfit"
                    android:singleLine="true"
                    android:textAllCaps="true"
                    android:textSize="15sp" />
                <View
                    android:id="@+id/big_rule"
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp" />
                <TextView
                    android:id="@+id/big_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:letterSpacing="0.14"
                    android:singleLine="true"
                    android:textAllCaps="true"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Picks: the current one large, the rest small -->
        <com.techpp.glass.PicksRow
            android:id="@+id/picks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="142dp"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <!-- Dock: one band, 5 to 10 apps (Talkies settings → Dock size), then the All apps button -->
        <FrameLayout
            android:id="@+id/dock_band"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="414dp"
            android:layout_marginEnd="20dp"
            android:clipChildren="false">
            <LinearLayout
                android:id="@+id/dock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:gravity="center"
                android:orientation="horizontal" />
        </FrameLayout>

        <!-- Below the fold: app channels (chosen in Control Center → Channels), then every other app.
             Their positions are set in code. -->
        <LinearLayout
            android:id="@+id/channels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="548dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/all_apps_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="566dp"
            android:fontFamily="@font/outfit"
            android:text="All apps"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="606dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingBottom="80dp" />
    </FrameLayout>

    <!-- The focus ring, drawn over whatever is focused -->
    <com.techpp.glass.HighlightView
        android:id="@+id/ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <TextView
        android:id="@+id/move_hint"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/outfit"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Inputs, Control Center and Channels menus; scrolls when long -->
    <ScrollView
        android:id="@+id/menu_scroll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fadingEdge="none"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp" />
    </ScrollView>
</FrameLayout>
